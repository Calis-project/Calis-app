# At least one provider key is required for live VLM analysis.
GEMINI_API_KEY=
GROQ_API_KEY=

# July 2026 free-tier defaults. Override without changing code.
CALIS_GEMINI_MODEL=gemini-3.6-flash
CALIS_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
CALIS_GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional. If absent, `calis-video download-model` writes to models/.
CALIS_POSE_MODEL=

# Processing limits.
CALIS_MAX_VIDEO_SECONDS=30
CALIS_MAX_UPLOAD_MB=40
CALIS_ANALYSIS_FPS=8
CALIS_MAX_OVERVIEW_FRAMES=8
CALIS_MAX_DETAIL_FRAMES=12

